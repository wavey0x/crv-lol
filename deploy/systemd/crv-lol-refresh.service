[Unit]
Description=Refresh CRV.LOL snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=svc-crv-lol
Group=svc-crv-lol
WorkingDirectory=/opt/crv-lol
EnvironmentFile=/etc/crv-lol.env
Environment=HOME=/var/lib/crv-lol
Environment=CRVLOL_SNAPSHOT_PATH=/var/lib/crv-lol/snapshot.json
ExecStart=/opt/crv-lol/venv/bin/brownie run refresh --network electro
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/crv-lol
